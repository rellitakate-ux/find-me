# Example: NEW empty local PostgreSQL database; do not point here if preserving your old data.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/find_me_demo?schema=public"
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Must be 64 hex characters. Keep your OLD KEY if reusing an existing database.
DATA_ENCRYPTION_KEY=

# Xendit dashboard > Developer settings > API keys > DEVELOPMENT secret key
# Live keys are rejected by this build. Never expose these values in frontend code.
XENDIT_SECRET_KEY=
# Xendit dashboard > Webhook settings > Callback verification token
XENDIT_WEBHOOK_TOKEN=
# Optional extra check: your Xendit business ID from the dashboard
XENDIT_BUSINESS_ID=
# Optional PUBLIC HTTPS frontend URL for checkout return, e.g. https://example.ngrok-free.app
# Leave blank while frontend is only at http://localhost:5173
FRONTEND_PUBLIC_URL=
